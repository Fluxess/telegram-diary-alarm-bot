# Токен твоего Telegram бота (получить у @BotFather)
BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Порт и хост для локального сервера Web App
WEBAPP_PORT=8080
WEBAPP_HOST=0.0.0.0

# Публичный URL для Web App (требуется HTTPS: домен, ngrok или cloudflare tunnel)
WEBAPP_URL=

# Прокси (если требуется для доступа к Telegram API, например: http://127.0.0.1:10809)
PROXY_URL=
